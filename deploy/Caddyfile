(coherent-site) {
    encode zstd gzip

    handle /api/* {
        reverse_proxy 127.0.0.1:8000
    }

    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}

{$PUBLIC_DOMAIN} {
    import coherent-site
}

www.{$PUBLIC_DOMAIN} {
    redir https://{$PUBLIC_DOMAIN}{uri} permanent
}

https://{$PUBLIC_IP} {
    tls /etc/letsencrypt/live/coherent-ip/fullchain.pem /etc/letsencrypt/live/coherent-ip/privkey.pem
    import coherent-site
}

{$PUBLIC_DOMAIN}:8443 {
    reverse_proxy 127.0.0.1:7880
}

https://{$PUBLIC_IP}:8443 {
    tls /etc/letsencrypt/live/coherent-ip/fullchain.pem /etc/letsencrypt/live/coherent-ip/privkey.pem
    reverse_proxy 127.0.0.1:7880
}

http://{$PUBLIC_IP} {
    handle /.well-known/acme-challenge/* {
        root * /var/www/certbot
        file_server
    }

    handle {
        redir https://{$PUBLIC_IP}{uri} permanent
    }
}
