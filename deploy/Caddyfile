(coherent-site) {
    encode zstd gzip
    header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' data: blob:; worker-src 'self' blob:; connect-src 'self' https: wss:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"

    handle /assets/* {
        root * /srv
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    handle /api/* {
        request_body {
            max_size 55MB
        }
        reverse_proxy 127.0.0.1:8000
    }

    handle {
        root * /srv
        header Cache-Control "no-cache"
        try_files {path} /index.html
        file_server
    }
}

{$PUBLIC_DOMAIN} {
    import coherent-site
}

www.{$PUBLIC_DOMAIN} {
    redir https://{$PUBLIC_DOMAIN}{uri} permanent
}

https://{$PUBLIC_IP} {
    tls /etc/letsencrypt/live/coherent-ip/fullchain.pem /etc/letsencrypt/live/coherent-ip/privkey.pem
    import coherent-site
}

{$PUBLIC_DOMAIN}:8443 {
    reverse_proxy 127.0.0.1:7880
}

https://{$PUBLIC_IP}:8443 {
    tls /etc/letsencrypt/live/coherent-ip/fullchain.pem /etc/letsencrypt/live/coherent-ip/privkey.pem
    reverse_proxy 127.0.0.1:7880
}

http://{$PUBLIC_IP} {
    handle /.well-known/acme-challenge/* {
        root * /var/www/certbot
        file_server
    }

    handle {
        redir https://{$PUBLIC_IP}{uri} permanent
    }
}
