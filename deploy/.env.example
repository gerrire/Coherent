# Public IPv4 of the VPS and the primary site domain.
PUBLIC_IP=31.76.77.197
PUBLIC_DOMAIN=coherent-web.ru

# Generate fresh random values on the VPS. Never commit deploy/.env.
POSTGRES_PASSWORD=replace-with-random-hex
SECRET_KEY=replace-with-at-least-32-random-characters
LIVEKIT_API_KEY=replace-with-random-hex
LIVEKIT_API_SECRET=replace-with-at-least-32-random-characters
TELEGRAM_BOT_TOKEN=replace-with-token-from-BotFather
TELEGRAM_PAIR_CODE=replace-with-at-least-12-random-characters

# User allowed to open the read-only admin panel.
ADMIN_USERNAME=gerrire

# Attachment storage limits, in MiB. Keep some free disk space for the OS and database.
ATTACHMENT_STORAGE_LIMIT_MB=15360
ATTACHMENT_MIN_FREE_MB=2048

# Provision /etc/coherent/keys/chat-master.key first; the path below is INSIDE the API container.
CHAT_MASTER_KEY_PATH=
CLOUD_ENCRYPTION_REQUIRED=false
# Enable after configuring and testing the sending server and DNS.
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@coherent-web.ru
