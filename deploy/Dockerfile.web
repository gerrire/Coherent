FROM rust:1.99.1-slim AS crypto
ENV CARGO_BUILD_JOBS=2
WORKDIR /crypto
RUN rustup target add wasm32-unknown-unknown \
    && cargo install wasm-bindgen-cli --version 0.2.129 --locked
COPY crates/coherent-crypto/Cargo.toml crates/coherent-crypto/Cargo.lock ./
COPY crates/coherent-crypto/src ./src
RUN cargo build --locked --release --target wasm32-unknown-unknown --features wasm \
    && wasm-bindgen --target web --out-dir /crypto-assets --out-name coherent_crypto target/wasm32-unknown-unknown/release/coherent_crypto.wasm

FROM node:22-alpine AS build

WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
COPY --from=crypto /crypto-assets ./public/crypto/v1
RUN npm run build

FROM caddy:2-alpine
COPY --from=build /app/dist /srv
COPY deploy/Caddyfile /etc/caddy/Caddyfile
