APP_ENV=development
# Explicit local opt-in only. Production rejects enabling this flag.
TEST_EMAIL_VERIFICATION_BYPASS=false
# Optional text-only cloud translation. Keep API keys on the server, never in VITE_*.
# ASR, VAD and speech synthesis still run on participant devices.
GIGACHAT_ENABLED=false
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_CA_BUNDLE=
GIGACHAT_MAX_CONCURRENCY=1
GIGACHAT_TIMEOUT_SECONDS=15
SECRET_KEY=replace-this-with-a-random-secret-of-at-least-32-characters
DATABASE_URL=postgresql+asyncpg://coherent:coherent@localhost:5433/coherent
POSTGRES_PORT=5433
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
COOKIE_SECURE=false

# Только для локальной разработки звонков: docker compose --profile calls up -d livekit
# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret
