{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Coherent",
  "version": "0.1.6",
  "identifier": "com.coherent.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Coherent",
        "width": 1280,
        "height": 800,
        "minWidth": 480,
        "minHeight": 420,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "fullscreen": false,
        "dataDirectory": "webview-v2",
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": "default-src 'self' http://tauri.localhost; frame-src 'none'; object-src 'none'; base-uri 'self'; connect-src 'self' https: wss: ipc: http://ipc.localhost; img-src 'self' data: blob:; media-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self' blob:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "windows": {
        "installMode": "quiet"
      },
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGNzdCNzk5QkZDM0Y5NjQKUldSaytjTy9tYmQzUDZOVnpXMTRISVRXdmJtVXZjTng3N0hPTlhlckZzTXFoRTRXajNwNk5SeUQK",
      "endpoints": [
        "https://github.com/gerrire/Coherent/releases/latest/download/latest.json"
      ]
    }
  }
}
