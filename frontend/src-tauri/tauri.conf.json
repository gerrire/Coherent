{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Coherent",
  "version": "0.1.0",
  "identifier": "com.coherent.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Coherent",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGNzdCNzk5QkZDM0Y5NjQKUldSaytjTy9tYmQzUDZOVnpXMTRISVRXdmJtVXZjTng3N0hPTlhlckZzTXFoRTRXajNwNk5SeUQK",
      "endpoints": ["https://github.com/gerrire/Coherent/releases/latest/download/latest.json"]
    }
  }
}
